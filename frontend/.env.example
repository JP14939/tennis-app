# config/api.js defaults to the hosted backend so the app works from any
# network out of the box. Only set this if you want to point a LOCAL dev
# build at your own machine's backend instead -- use your dev machine's LAN
# IP (check with `ipconfig` / `ifconfig`, Wi-Fi networks often reassign it)
# so Expo Go on a phone on the same Wi-Fi can reach it. Expo inlines any
# EXPO_PUBLIC_* variable into the build automatically -- no extra config
# needed.
EXPO_PUBLIC_API_BASE=http://192.168.1.236:5000

# RevenueCat's public Web Billing API key (safe to expose client-side --
# it's a publishable key, not a secret). Used by
# components/PremiumCheckout.web.js. Leave unset and the checkout card
# simply doesn't render (PremiumScreen falls back to its existing
# alert-based flow).
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=your_revenuecat_public_web_api_key_here

# RevenueCat's public SDK keys for native (iOS/Android) in-app purchases --
# also publishable, safe client-side. Used by services/purchasesInit.native.js
# and components/PremiumCheckout.native.js. Get these from the RevenueCat
# dashboard under Project Settings > API Keys (one per app/platform).
# Requires a dev client build (react-native-purchases is native-only, not
# supported in Expo Go) -- see DEPLOY.md / eas.json.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_public_api_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_public_api_key_here

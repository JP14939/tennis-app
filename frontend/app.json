{
  "expo": {
    "name": "RallyMax",
    "slug": "tennisai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jackp.tennisai"
    },
    "android": {
      "package": "com.jackp.tennisai",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-av",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RallyMax to access your videos for swing analysis."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RallyMax to access your camera to record your swing.",
          "microphonePermission": "Allow RallyMax to access your microphone to record video with sound."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RallyMax to use your location to show tennis courts near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d0d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "dd4317f3-95c2-4aff-92cd-9f1567904dac"
      }
    }
  }
}

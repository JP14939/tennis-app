PORT=5000
NODE_ENV=development
# Generate a real random value for any non-local deploy, e.g. `openssl rand -hex 32` -- never reuse the local dev value.
JWT_SECRET=your_dev_secret_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tennis_app_dev
ANTHROPIC_API_KEY=your_key_here
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_key_here
S3_BUCKET=tennis-app-mvp-videos
REVENUECAT_PROJECT_ID=your_project_id_here
REVENUECAT_SECRET_API_KEY=your_v2_secret_key_here
REVENUECAT_WEBHOOK_SECRET=your_webhook_shared_secret_here
REVENUECAT_ENTITLEMENT_ID=premium
REDIS_URL=redis://localhost:6379
# Self-serve password reset (routes/auth.js, utils/email.js). Get an API key
# at resend.com; the shared sandbox sender only works for the account
# owner's own email until a real domain is verified in Resend's dashboard.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=RallyMax <onboarding@resend.dev>
# This backend's own public URL -- used to build the reset-password.html
# link sent in the email. Must match wherever the backend is actually reachable.
PUBLIC_BASE_URL=https://rallymax.167-233-107-31.sslip.io
